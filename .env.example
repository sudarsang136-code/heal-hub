# Copy to .env (never commit .env) and fill in. Export these before running, or use `set -a; source .env; set +a`.

# Flask session secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=

# Fernet key for encrypting donor phone/email. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEALHUB_ENCRYPTION_KEY=

# Admin console login (admin is disabled if these are unset)
ADMIN_ID=
ADMIN_PASSWORD=

# Optional: real email dispatch via Gmail SMTP (app password, not your normal password)
SMTP_SENDER=
APP_PASSWORD=

# Optional
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
PORT=5000
